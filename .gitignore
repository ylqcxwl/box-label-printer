# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 打包产物
build/
dist/
*.spec.bak

# 分发压缩包：单个约 44MB，属于构建产物，应走 GitHub Releases 而非进仓库
*.zip

# 运行数据（绿色软件运行后生成，不入库）
# 注意：这里存着产品库、打印记录、自定义 LOGO、窗口尺寸等真实业务数据，绝不能入库
data/

# 测试 / 验收产物：界面截图与本机验证脚本，只在开发时用，不进仓库
# （截图命名形如 v102_打印记录.png、v103_列表设置.png）
v10*.png
_verify*.py

# 运行时生成的图片：下拉箭头等由 icons.py 在启动时画进 assets/，
# 属于缓存，不需要进仓库（assets/logo.ico 与 logo.png 是程序图标，要入库）
assets/arrow_*.png

# 日志（含 WorkBuddy 自动化产生的运行日志）
*.log
@AutomationLog.txt

# 系统文件
Thumbs.db
.DS_Store
